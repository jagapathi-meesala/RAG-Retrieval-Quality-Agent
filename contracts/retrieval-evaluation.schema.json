{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RAG Retrieval Evaluation Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "queries"
  ],
  "properties": {
    "queries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "query_id",
          "retrieved",
          "relevance"
        ],
        "properties": {
          "query_id": {
            "type": "string",
            "minLength": 1
          },
          "retrieved": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "relevance": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "expected_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
